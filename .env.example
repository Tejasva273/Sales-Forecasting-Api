# -----------------------------------------------------------------------------
# Sales Forecasting & Analytics API - Example environment configuration
# Copy this file to `.env` and adjust values. NEVER commit the real .env file.
# -----------------------------------------------------------------------------

# Database connection string.
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./sales.db
# MySQL (drop-in replacement, requires `pip install pymysql`):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sales

# Path where the trained ML model is persisted (joblib).
MODEL_PATH=models/sales_model.pkl

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Directory for application log files.
LOG_DIR=logs

# Path used to store/read the raw sample dataset.
RAW_DATA_PATH=data/raw/sales_data.csv

# Path used to store the cleaned dataset.
PROCESSED_DATA_PATH=data/processed/sales_clean.csv

# Directory where EDA charts are written.
CHART_DIR=data/processed/charts

# Maximum number of days allowed in a single forecast request.
MAX_FORECAST_DAYS=365

# Default pagination page size for /sales.
DEFAULT_PAGE_SIZE=50
